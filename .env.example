# --- Chat (IRC) ---
# Account Pixel types as. Can be your streamer login or a bot login.
TWITCH_NICK=your_bot_or_streamer_login
TWITCH_CHANNEL=your_channel
# Scopes: chat:read chat:edit. Prefix with oauth: if missing.
TWITCH_TOKEN=oauth:xxxxxxxx

# --- Alerts (EventSub) — separate from IRC ---
# Client ID from the SAME generate step as the event token (Token Generator shows it).
TWITCH_CLIENT_ID=

# Leave empty if Pixel chats as YOUR streamer account and TWITCH_TOKEN already has:
#   chat:read  chat:edit  moderator:read:followers  channel:read:subscriptions
# Fill this only if IRC is a bot: generate a second token while logged in as the streamer.
TWITCH_EVENT_TOKEN=
