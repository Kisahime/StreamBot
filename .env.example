# --- Chat (IRC) ---
# Account Pixel types as. Can be your streamer login or a bot login.
TWITCH_NICK=your_bot_or_streamer_login
TWITCH_CHANNEL=your_channel
# Scopes: chat:read chat:edit. Prefix with oauth: if missing.
# If this account is also the streamer, add the event scopes listed under TWITCH_EVENT_TOKEN.
TWITCH_TOKEN=oauth:xxxxxxxx

# --- Alerts (EventSub) — separate from IRC ---
# Client ID from the SAME generate step as the event token (Token Generator shows it).
TWITCH_CLIENT_ID=

# Leave empty if Pixel chats as YOUR streamer account and TWITCH_TOKEN already has the scopes below.
# Fill this only if IRC is a bot: generate a second token while logged in as the streamer.
# Always: moderator:read:followers  channel:read:subscriptions
# Optional feeds (off in config.yaml until you turn them on):
#   bits:read
#   channel:read:redemptions   (or channel:manage:redemptions)
#   channel:read:hype_train
#   channel:read:polls         (or channel:manage:polls)
#   channel:read:predictions   (or channel:manage:predictions)
# Helix actions: moderator:manage:shoutouts (!so)  channel:manage:broadcast (stream markers)
TWITCH_EVENT_TOKEN=

# Optional stable token for a Stream Deck or hotkey. Leave empty to keep the
# per-launch session token as the only key. When set, it is accepted as
# X-Cohost-Token only on POST /api/interrupt, /api/tts/mute, /api/ptt,
# /api/marker, /api/mood, and /api/profile.
COHOST_CONTROL_KEY=
